    <string name="burnout_title">Burnout Protection Method</string>
    <string name="burnout_none_title">No Protection</string>
    <string name="burnout_none_desc">⚠️ WARNING: Permanent display in the same spot risks permanent pixel burn-in on AMOLED displays.</string>
    <string name="burnout_ps_title">Pixel-Shift</string>
    <string name="burnout_ps_desc">Slightly shifts the AODiode position, evenly distributing wear across surrounding subpixels.</string>
    <string name="burnout_dither_title">Subpixel-Dithering</string>
    <string name="burnout_dither_desc">Alternately turns adjacent pixels on and off in a checkerboard pattern (Privacy Display principle). Position remains fixed.</string>
    <string name="burnout_dither_note">💡 Note: May have slightly lower brightness, resulting in even lower battery consumption.</string>
